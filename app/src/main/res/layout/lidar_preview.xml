<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/container_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorAccent"
        android:layout_below="@id/LinearLayoutHeader"
        android:layout_centerInParent="true">
        <sg.edu.nus.comp.android3dvisualisationtool.app.openGLES20Support.GLES20SurfaceView
            android:id="@+id/gl_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <edu.osu.pcv.marslogger.AspectFrameLayout
        android:id="@+id/cameraPreview_afl"
        android:layout_width="144dp"
        android:layout_height="256dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="4dp"
        android:layout_below="@id/LinearLayoutHeader" >

        <edu.osu.pcv.marslogger.SampleGLView
            android:id="@+id/cameraPreview_surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </edu.osu.pcv.marslogger.AspectFrameLayout>

    <!-- these overlap with the SurfaceView; by default, it's underneath the UI layer -->

    <TextView
        android:id="@+id/cameraParams_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/LinearLayoutHeader"
        android:layout_alignStart="@id/container_body"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:text="[?]"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:id="@+id/captureResult_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/cameraParams_text"
        android:text="focal length : exposure time" />

    <TextView
        android:id="@+id/cameraOutputDirLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/captureResult_text"
        android:text="@string/cameraOutputDirLabel_text" />

    <TextView
        android:id="@+id/cameraOutputDir_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/cameraOutputDirLabel"
        android:layout_alignBottom="@id/cameraOutputDirLabel"
        android:layout_toEndOf="@id/cameraOutputDirLabel"
        android:paddingStart="4dp"
        android:text="@string/cameraOutputDir_text" />

    <TextView
        android:id="@+id/lidarIdLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/cameraOutputDirLabel"
        android:text="Mid360 Id: " />

    <TextView
        android:id="@+id/lidarIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/lidarIdLabel"
        android:layout_alignBottom="@id/lidarIdLabel"
        android:layout_toEndOf="@id/lidarIdLabel"
        android:paddingStart="4dp"
        android:text="1xx" />

    <TextView
        android:id="@+id/masterUriLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/lidarIdLabel"
        android:text="Master URI: " />

    <TextView
        android:id="@+id/masterUriText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/masterUriLabel"
        android:layout_alignBottom="@id/masterUriLabel"
        android:layout_toEndOf="@id/masterUriLabel"
        android:paddingStart="4dp"
        android:text="http://10.135.11.x:11311/" />

    <TextView
        android:id="@+id/numLidarMsgLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/masterUriLabel"
        android:text="#Lidar Msg: " />

    <TextView
        android:id="@+id/numLidarMsgText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/numLidarMsgLabel"
        android:layout_alignBottom="@id/numLidarMsgLabel"
        android:layout_toEndOf="@id/numLidarMsgLabel"
        android:paddingStart="4dp"
        android:text="0" />

    <TextView
        android:id="@+id/currentPositionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/numLidarMsgLabel"
        android:text="Lidar loc: " />

    <TextView
        android:id="@+id/currentPositionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/currentPositionLabel"
        android:layout_alignBottom="@id/currentPositionLabel"
        android:layout_toEndOf="@id/currentPositionLabel"
        android:paddingStart="4dp"
        android:text="0.0, 0.0" />

    <TextView
        android:id="@+id/gnssRtkLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/cameraParams_text"
        android:layout_below="@id/currentPositionLabel"
        android:text="GNSS-RTK: " />

    <TextView
        android:id="@+id/gnssRtkText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/gnssRtkLabel"
        android:layout_alignBottom="@id/gnssRtkLabel"
        android:layout_toEndOf="@id/gnssRtkLabel"
        android:paddingStart="4dp"
        android:text="" />
</merge>
